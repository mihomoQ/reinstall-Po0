{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reinstall-po0",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "reinstall.aa.jp.eu.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "none"
  },
  "build": {
    "command": "git archive --format=tar.gz --prefix=reinstall-Po0/ --output=public/reinstall.tar.gz HEAD"
  }
}
